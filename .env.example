# Copy to .env, then set your OWN non-default secret values.
DB_PASSWORD=replace_with_local_db_password
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
JWT_EXPIRATION=3600000
TLS_KEYSTORE_PASSWORD=replace_with_your_keystore_password

# HTTPS client address = https://TLS_HOST:HTTPS_PORT (host IP/DNS must be reachable).
# For a physical Android device on Wi-Fi, set TLS_HOST to the PC's LAN IPv4 before FIRST startup.
# Emulators usually reach a host via 10.0.2.2 (already included in the dev SAN).
TLS_HOST=localhost
HTTPS_PORT=8443

# Container names are global per Docker host. Use unique values for parallel installs.
DB_CONTAINER_NAME=db
BACKEND_CONTAINER_NAME=ems-server
CERT_INIT_CONTAINER_NAME=cert-init
# Optional Compose project name (changing it also changes the PostgreSQL volume):
# COMPOSE_PROJECT_NAME=nnpro

# For parallel installations on the same machine, configure each .env file with:
# unique COMPOSE_PROJECT_NAME (or use docker compose -p), HTTPS_PORT,
# TLS_CERTS_DIR, DB_CONTAINER_NAME, BACKEND_CONTAINER_NAME and independent credentials.
# Optional: HTTPS_BIND_IP=0.0.0.0
# Optional: TLS_CERTS_DIR=./certs/company_a

# Optional (IntelliJ native tests only): TEST_DB_HOST_PORT=55432
# Optional (Docker tests): TEST_DB_PASSWORD=nnpro_local_test

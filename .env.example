# Copy this file to .env and set unique secrets before starting Docker Compose.
# Empty required values cause Compose to stop rather than use default passwords.
DB_PASSWORD=
JWT_SECRET=
SWAGGER_PASSWORD=
TLS_KEYSTORE_PASSWORD=

# Backend application settings. Values below preserve the current defaults.
DB_URL=jdbc:postgresql://db:5432/nnpro
DB_USERNAME=nnpro
SERVER_PORT=8443
SPRING_APPLICATION_NAME=enterprise-messages-server
SPRING_JACKSON_DESERIALIZATION_FAIL_ON_UNKNOWN_PROPERTIES=true
SPRING_JACKSON_DESERIALIZATION_FAIL_ON_TRAILING_TOKENS=true
SPRING_JACKSON_MAPPER_ALLOW_COERCION_OF_SCALARS=false
SPRING_JACKSON_READ_STRICT_DUPLICATE_DETECTION=true
API_MAX_REQUEST_BODY_BYTES=1048576
API_MAX_CONCURRENT_REQUESTS=128
WS_MAX_CONCURRENT_MESSAGES=32
WS_MAX_CONNECTIONS=2000
SERVER_TOMCAT_THREADS_MAX=200
SERVER_TOMCAT_THREADS_MIN_SPARE=10
SERVER_TOMCAT_MAX_CONNECTIONS=8192
SERVER_TOMCAT_ACCEPT_COUNT=100
SERVER_TOMCAT_CONNECTION_TIMEOUT=20s
SERVER_TOMCAT_KEEP_ALIVE_TIMEOUT=20s
SERVER_TOMCAT_MAX_KEEP_ALIVE_REQUESTS=100
SERVER_MAX_HTTP_REQUEST_HEADER_SIZE=16KB
SERVER_TOMCAT_MAX_PARAMETER_COUNT=100
SERVER_TOMCAT_MAX_HTTP_FORM_POST_SIZE=1MB
SERVER_TOMCAT_MAX_SWALLOW_SIZE=1MB
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=5000
SPRING_DATASOURCE_HIKARI_VALIDATION_TIMEOUT=1000
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_OPEN_IN_VIEW=false

# Address and port that clients will use to connect to this installation.
# TLS_HOST is included in the SAN only when a new development cert is created.
TLS_HOST=localhost
HTTPS_PORT=8443
HTTPS_BIND_IP=0.0.0.0
TLS_CERTS_DIR=./certs

# Optional: customize these when hosting multiple deployments on the same host.
# Use a unique Compose project and ALL THREE container names per installation.
# COMPOSE_PROJECT_NAME=ems
# BACKEND_CONTAINER_NAME=ems-server
# DB_CONTAINER_NAME=ems-db
# CERT_INIT_CONTAINER_NAME=cert-init

# Optional: locally adjust authentication-token lifetime (milliseconds).
# JWT_EXPIRATION=3600000

# Registration validation limits.
REGISTRATION_USERNAME_MIN_LENGTH=3
REGISTRATION_USERNAME_MAX_LENGTH=50
REGISTRATION_PASSWORD_MIN_LENGTH=6

# Optional (IntelliJ tests using the Compose test database).
# TEST_DB_HOST_PORT=55432
# Optional (test database).
#TEST_DB_PASSWORD=nnpro_local_test

# Copy to .env and replace the placeholders with your own secrets.
DB_PASSWORD=replace_with_local_db_password
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
# JWT expiration is in milliseconds (3,600,000 = 1 hour).
JWT_EXPIRATION=3600000
# Use exactly the password entered when creating certs/keystore.p12.
TLS_KEYSTORE_PASSWORD=replace_with_your_keystore_password
# Optional: TEST_DB_PASSWORD=nnpro_local_test

# Copy this file to .env and set unique secrets before starting Docker Compose.
# Empty required values cause Compose to stop rather than use default passwords.
DB_PASSWORD=
JWT_SECRET=
SWAGGER_PASSWORD=
TLS_KEYSTORE_PASSWORD=

# Address and port that clients will use to connect to this installation.
# TLS_HOST is included in the SAN only when a new development cert is created.
TLS_HOST=localhost
HTTPS_PORT=8443
HTTPS_BIND_IP=0.0.0.0
TLS_CERTS_DIR=./certs

# Optional: customize these when hosting multiple deployments on the same host.
# Use a unique Compose project and ALL THREE container names per installation.
# COMPOSE_PROJECT_NAME=ems
# BACKEND_CONTAINER_NAME=ems-server
# DB_CONTAINER_NAME=db
# CERT_INIT_CONTAINER_NAME=cert-init

# Optional: locally adjust authentication-token lifetime (milliseconds).
# JWT_EXPIRATION=3600000

# Registration validation limits.
REGISTRATION_USERNAME_MIN_LENGTH=3
REGISTRATION_USERNAME_MAX_LENGTH=50
REGISTRATION_PASSWORD_MIN_LENGTH=6

# Optional (IntelliJ tests using the Compose test database).
# TEST_DB_HOST_PORT=55432
# Optional (test database).
#TEST_DB_PASSWORD=nnpro_local_test